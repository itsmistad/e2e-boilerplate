{
    "name": "@apps/orchestrator",
    "version": "1.0.0",
    "main": "src/index.ts",
    "scripts": {
        "clean": "rm -rf dist && rm -rf node_modules/",
        "start": "pnpm start:development",
        "start:development": "chmod +x ./scripts/start.sh && ./scripts/start.sh development",
        "start:staging": "chmod +x ./scripts/start.sh && ./scripts/start.sh staging",
        "start:production": "chmod +x ./scripts/start.sh && ./scripts/start.sh production",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "build": "tsc --build --clean",
        "preinstall": "npx only-allow pnpm",
        "unused": "knip --no-config-hints",
        "pb:typegen": "chmod +x ./scripts/gen-pb-types.sh && ./scripts/gen-pb-types.sh",
        "pb:serve": "[[ $OSTYPE == 'darwin'* ]] && ./pocketbase_0.30.0_darwin_arm64 serve || ./pocketbase_0.30.0_windows_amd64.exe serve",
        "pb:help": "[[ $OSTYPE == 'darwin'* ]] && ./pocketbase_0.30.0_darwin_arm64 $@ help || ./pocketbase_0.30.0_windows_amd64.exe $@ help"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@eslint/markdown": "^6.2.2",
        "@types/cors": "^2.8.19",
        "@types/node": "^22.10.2",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/parser": "^8.44.0",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^3.7.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-yml": "^1.16.0",
        "knip": "^5.63.1",
        "msw": "^2.11.3",
        "pocketbase-typegen": "^1.3.2",
        "sqlite3": "github:TryGhost/node-sqlite3#v5.1.7",
        "prettier": "^3.4.2",
        "tsx": "^4.19.2",
        "typescript": "5.7.3",
        "typescript-eslint": "8.44.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4"
    },
    "author": "itsmistad",
    "license": "MIT",
    "type": "module",
    "private": true,
    "dependencies": {
        "@dotenvx/dotenvx": "^1.51.1",
        "@trpc/server": "11.6.0",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "pocketbase": "^0.26.2",
        "superjson": "^2.2.2",
        "uuid": "^11.1.0",
        "zod": "^3.24.1"
    }
}
